# Public configuration template. Keep the populated .env file local.
# The documented walkthrough supplies its own isolated configuration and memory.
# This template disables model calls; it does not sanitize generated artifacts.
INSIGHTS_DEFAULT_LLM_MODEL="offline"

# To enable model enrichment, replace offline with a provider:model-id supported
# by your installed PydanticAI version and available from your provider.
# Check the provider's current model list and install its SDK extra with uv.
# The base Nouc dependency includes the Google extra.
# Inspect configuration with: uv run nouc models
# Symbol introspection does not verify provider access or model availability.
# A coding-agent subscription does not supply Python API credentials.

# Optional credentials. Leave unused fields empty.
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GITHUB_TOKEN=""

# Optional self-hosted endpoint. Set a matching provider:model-id above.
# INSIGHTS_LLM_BASE_URL="http://localhost:11434/v1"
# INSIGHTS_LLM_API_KEY=""

# Override BOTH memory paths for a dedicated example/session if using the CLI.
# Existing memory may contain private data and is copied into generated bundles.
# INSIGHTS_LOCAL_MEMORY_DIR="private/example-memory/local"
# INSIGHTS_GLOBAL_MEMORY_DIR="private/example-memory/global"

# These reflect configuration fields, not a guarantee that every build path
# enforces them. Check reports and run: uv run nouc verify <app.py> --ty
INSIGHTS_MONTY_TIMEOUT_MS=2000
INSIGHTS_STRICT_VERIFICATION=true
INSIGHTS_DEEPWIKI_MCP_URL="https://mcp.deepwiki.com/mcp"
