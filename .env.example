# ============================================================================
# Nouc Studio Configuration (.env.example)
# Copy this file to `.env` (`cp .env.example .env`) and configure your choice
# of Cloud API, Local/Self-Hosted AI (Ollama, vLLM, LM Studio, llama.cpp),
# GitHub Copilot / GitHub Models, or Deterministic Offline mode.
# All model identifiers below are verified live against `pydantic_ai.models.KnownModelName`.
# ============================================================================

# ----------------------------------------------------------------------------
# OPTION A — Cloud Frontier APIs (Google Gemini 3.8/4, Claude 5.5, GPT-6 Sol)
# ----------------------------------------------------------------------------
# Google Gemini via official `google-genai` SDK (default):
INSIGHTS_DEFAULT_LLM_MODEL="google:gemini-3.8-flash"
# Or flagship Gemini 4:
# INSIGHTS_DEFAULT_LLM_MODEL="google:gemini-4-argon"
GEMINI_API_KEY=""
# For Google Cloud Vertex AI:
# INSIGHTS_DEFAULT_LLM_MODEL="google-cloud:gemini-4-argon"

# Anthropic Claude Sonnet 5.5 / Opus 5.5:
# INSIGHTS_DEFAULT_LLM_MODEL="anthropic:claude-sonnet-5-5"
# INSIGHTS_DEFAULT_LLM_MODEL="anthropic:claude-opus-5-5"
ANTHROPIC_API_KEY=""

# OpenAI GPT-6 Sol / GPT-6.1 Sol:
# INSIGHTS_DEFAULT_LLM_MODEL="openai:gpt-6-sol"
# INSIGHTS_DEFAULT_LLM_MODEL="openai:gpt-6.1-sol"
OPENAI_API_KEY=""

# ----------------------------------------------------------------------------
# OPTION B — Local & Self-Hosted AI (Ollama, vLLM, LM Studio, llama.cpp, SGLang)
# 100% Air-Gapped / Sovereign Execution (Qwen3-Coder, Gemma 4, DeepSeek V4)
# ----------------------------------------------------------------------------
# 1) Ollama (local daemon on port 11434):
# INSIGHTS_DEFAULT_LLM_MODEL="ollama:qwen3-coder:30b"
# INSIGHTS_DEFAULT_LLM_MODEL="ollama:gemma4:31b"
# INSIGHTS_LLM_BASE_URL="http://localhost:11434/v1"

# 2) vLLM / SGLang / TGI (self-hosted OpenAI-compatible server on port 8000):
# INSIGHTS_DEFAULT_LLM_MODEL="openai:Qwen/Qwen3-Coder-Next"
# INSIGHTS_DEFAULT_LLM_MODEL="openai:deepseek-ai/DeepSeek-V4-Pro"
# INSIGHTS_DEFAULT_LLM_MODEL="openai:google/gemma-4-31b-it"
# INSIGHTS_LLM_BASE_URL="http://localhost:8000/v1"
# INSIGHTS_LLM_API_KEY="local-no-key"

# 3) LM Studio / llama.cpp server (local OpenAI-compatible server on port 1234):
# INSIGHTS_DEFAULT_LLM_MODEL="openai:local-model"
# INSIGHTS_LLM_BASE_URL="http://localhost:1234/v1"
# INSIGHTS_LLM_API_KEY="lm-studio"

# ----------------------------------------------------------------------------
# OPTION C — GitHub Copilot / GitHub Models Inference API
# ----------------------------------------------------------------------------
# Uses your GitHub Personal Access Token or Copilot-enabled GITHUB_TOKEN:
# INSIGHTS_DEFAULT_LLM_MODEL="openai:gpt-6-sol"
# INSIGHTS_LLM_BASE_URL="https://models.github.ai/inference"
GITHUB_TOKEN=""

# ----------------------------------------------------------------------------
# OPTION D — Deterministic Offline Mode (Zero External LLM Calls)
# ----------------------------------------------------------------------------
# INSIGHTS_DEFAULT_LLM_MODEL="offline"

# ----------------------------------------------------------------------------
# Sandbox & Grounding Settings
# ----------------------------------------------------------------------------
INSIGHTS_MONTY_TIMEOUT_MS=2000
INSIGHTS_STRICT_VERIFICATION=true
INSIGHTS_DEEPWIKI_MCP_URL="https://mcp.deepwiki.com/mcp"
